<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Dhruva's ONLY network use: Hugging Face model browsing + downloads
         (user-initiated). Zero telemetry — see orchestra/PROTOCOL rule 5. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Loop 7 (vision): camera capture for the chat attach button.
         image_picker's gallery source uses the system photo picker on API
         33+ (no permission needed) and READ_EXTERNAL_STORAGE below API 33
         (merged in automatically by the plugin's own manifest); camera
         needs this declared explicitly since the plugin doesn't force it
         on apps that only use the gallery source. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Android 13+ (API 33): required for background_downloader to show a
         download-progress notification. Requested at runtime on first
         download setup (BackgroundDownloaderBackend.configureNotifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Model downloads run in an Android foreground service (Config.runInForeground
         = always) so they survive the app being backgrounded. On API 34+ starting
         background_downloader's dataSync service (UIDTJobService, declared with
         android:foregroundServiceType="dataSync" in the plugin manifest) throws a
         SecurityException — crashing the app — unless BOTH of these are granted.
         Their absence was the 0.2.2 "app crashes when a download starts" regression. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Connectors (daily assistant, Wave 2A). READ ONLY: the calendar and
         contacts connectors never write, so only the READ permissions are
         declared; there is deliberately no WRITE_CALENDAR / WRITE_CONTACTS and
         no MANAGE_EXTERNAL_STORAGE (the Files folder goes through the system
         folder picker). Each is requested only when the user taps Connect. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Morning brief (Settings > Notifications, off by default): local
         notifications scheduled on the phone, no network. Inexact alarms, so no
         exact-alarm permission. BOOT_COMPLETED lets the plugin put the next
         mornings back after a reboot; opening the app tops them up too. The
         notification text is a constant and never carries the user's data. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Backup lockdown (daily-assistant spec B1): chats, the model index and,
         later, connector data must never leave the phone via Google backup or
         a device-to-device transfer. allowBackup/fullBackupContent cover
         Android 11 and below; dataExtractionRules (excluding every domain, for
         both cloud-backup and device-transfer) covers Android 12+. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Dhruva AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share sheet: "Dhruva AI" appears when sharing plain text from any
                 app; opens Workflows with the text prefilled (IntentInbox). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Static launcher shortcuts (long-press the app icon). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>
        <!-- Text-selection menu: "Ask Dhruva AI" shows up next to Copy/Paste in
             every app. A UI-less trampoline (NOT a Flutter activity: it must not
             boot a second engine/app in this process). It forwards the text to
             MainActivity and stays standard-launch-mode in the calling app's
             task so an editable field can still get "Replace selected text"
             back via setResult(EXTRA_PROCESS_TEXT). -->
        <activity
            android:name=".ProcessTextActivity"
            android:label="Ask Dhruva AI"
            android:exported="true"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:theme="@style/TrampolineTheme">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Quick Settings tile "Ask Dhruva": opens a new chat via the same
             `route` intent the launcher shortcuts use. BIND_QUICK_SETTINGS_TILE
             restricts binding to the system. -->
        <service
            android:name=".DhruvaTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_star"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Home-screen widget (4x1, resizable to 2x1). Exported so the launcher
             can send APPWIDGET_UPDATE; the actions it triggers are PendingIntents
             we own. -->
        <receiver
            android:name=".DhruvaWidgetProvider"
            android:exported="true"
            android:label="@string/tile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dhruva_widget_info"/>
        </receiver>
        <!-- Notification digest listener (Android only, off by default). Exported
             because the system must bind it, but ONLY the system can: the
             BIND_NOTIFICATION_LISTENER_SERVICE permission is signature-level.
             It records nothing until the user grants notification access in
             system settings AND turns the connector on in the app; it writes
             title/text/app/time to an app-private queue file and never touches
             the database or the network. See NotificationCaptureService. -->
        <service
            android:name="tech.appuinside.dhruva.connectors.NotificationCaptureService"
            android:exported="true"
            android:label="Dhruva AI"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- flutter_local_notifications: fires the scheduled morning brief and
             re-schedules it after a reboot. Not exported: only the plugin's own
             alarms and the system's boot broadcast reach them. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- background_downloader runs its download via a WorkManager worker that
             promotes itself to a foreground service (Config.runInForeground). On
             API 34+, WorkManager's SystemForegroundService starts foreground with
             type dataSync (0x1), but androidx.work's own manifest declares that
             service with NO foregroundServiceType (0x0) — so Android throws
             "foregroundServiceType 0x1 is not a subset of 0x0" and crashes the app
             the moment a download starts. Merging the dataSync type onto that
             service is the other half of the fix (the two uses-permission lines
             above are necessary but not sufficient). Verified on-device (API 36):
             without this, tapping Download crashes; with it, downloads run. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Inbox "Open app": launch the app a notification came from. Lets us
             see launchable apps (and open one by package name) without
             QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
