<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc export for Firebase App Distribution. Signing is automatic so
	     Xcode's signed-in account manages the profile (pass
	     -allowProvisioningUpdates); ExportOptions-AppStore.plist is the
	     TestFlight/App Store twin. -->
	<key>method</key>
	<string>release-testing</string>
	<key>teamID</key>
	<string>9AA3ASU85Q</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<false/>
	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
