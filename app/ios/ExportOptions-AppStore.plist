<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight export. ExportOptions.plist stays ad-hoc for
	     Firebase App Distribution; this one re-signs the same archive with an
	     App Store profile Xcode manages (needs -allowProvisioningUpdates and a
	     signed-in Xcode account) and uploads it to App Store Connect. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>9AA3ASU85Q</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
