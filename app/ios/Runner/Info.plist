<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dhruva AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>dhruva</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Gmail sign-in callback (google_sign_in). GMAIL_IOS_URL_SCHEME is set in
	     Flutter/Debug.xcconfig and Release.xcconfig to the reversed iOS client
	     id. The client id itself comes from --dart-define=GMAIL_IOS_CLIENT_ID.
	     This scheme is for Google sign-in only: no app route may be reachable
	     from a URL (spec section 8), so Flutter's own deep-link routing is off
	     (FlutterDeepLinkingEnabled). google_sign_in_ios receives the redirect
	     through the plugin's own application/scene delegate (openURLContexts),
	     which does not depend on that key. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>gmail-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GMAIL_IOS_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Dhruva reads your calendar to show your day and prepare you for meetings. It only reads, never changes your calendar, and nothing leaves your device.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Dhruva reads your calendar to show your day and prepare you for meetings. It only reads, never changes your calendar, and nothing leaves your device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Dhruva uses the camera to attach a photo to a chat message with a vision model — nothing leaves your device.</string>
	<key>NSContactsUsageDescription</key>
	<string>Dhruva looks up the names and photos of people in your meetings. It only reads, looks up one person at a time, and nothing leaves your device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dhruva uses the microphone for voice chat. Speech is transcribed on your device and never uploaded.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Dhruva uses your photo library to attach a photo to a chat message with a vision model — nothing leaves your device.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- The launch screen is navy in both themes: light status bar content
	     during launch. Flutter takes over the style once it draws. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
